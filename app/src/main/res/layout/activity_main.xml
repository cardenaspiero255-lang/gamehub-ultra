<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAMEHUB ULTRA"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Detectando dispositivo..."
            android:textColor="#B8BBC7"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PERFIL DE OPTIMIZACIÓN"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/profileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/profileBalanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚖  Balanced FPS"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/profileCool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❄  Cool — menor temperatura"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/profilePerformance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥  Performance — máximo FPS"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/profileX2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡  Frame Interpolation X2"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/profileX4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💀  Frame Interpolation X4"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </RadioGroup>

        <Button
            android:id="@+id/optimizeButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="OPTIMIZAR PARA GAMEHUB"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Listo para optimizar."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
